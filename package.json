{
  "name": "bitflix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Bitflix — a 'Netflix inside the chat' MCP App, built on Skybridge. A streaming OVP a customer could build on Bitmovin so users browse, get recommendations, and watch live/VOD by talking to Claude or ChatGPT.",
  "scripts": {
    "dev": "skybridge dev",
    "dev:tunnel": "skybridge dev --tunnel",
    "build": "skybridge build",
    "start": "skybridge start",
    "deploy": "alpic deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@t3-oss/env-core": "^0.13.8",
    "bitmovin-player": "^8.253.0",
    "bitmovin-player-ui": "^4.20.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "skybridge": "^1.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@skybridge/devtools": "^1.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "alpic": "^1.104.1",
    "tsx": "^4.19.4",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
