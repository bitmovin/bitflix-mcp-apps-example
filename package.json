{
  "name": "bitflix-mcp-apps-example",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Bitflix - MCP Apps Example Application",
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=DEP0190 skybridge dev --no-open",
    "dev:tunnel": "NODE_OPTIONS=--disable-warning=DEP0190 skybridge dev --no-open --tunnel",
    "build": "skybridge build",
    "start": "skybridge start",
    "deploy": "alpic deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.8",
    "bitmovin-player": "^8.253.0",
    "bitmovin-player-ui": "^4.20.2",
    "dotenv": "^17.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "skybridge": "^2.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@skybridge/devtools": "^2.0.0",
    "@skybridge/vite-plugin": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.1",
    "alpic": "^1.104.1",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
